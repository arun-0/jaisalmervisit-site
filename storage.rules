rules_version = '2';

// Visit Jaisalmer — Storage security rules.
// Public read for site images and audio; uploads only by admins (admins/{email} in Firestore).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /images/{path=**} {
      allow read;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /audio/{path=**} {
      allow read;
      allow create, update: if isAdmin()
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
